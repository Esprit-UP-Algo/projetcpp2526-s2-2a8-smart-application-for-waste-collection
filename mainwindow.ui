            <widget class="QTableWidget" name="tableWidget_2">
             <property name="geometry">
              <rect>
               <x>610</x>
               <y>350</y>
               <width>621</width>
               <height>471</height>
              </rect>
             </property>
             <property name="styleSheet">
              <string notr="true">/* ===== TABLE PRINCIPALE ===== */
QTableWidget {
    background-color: white;
    border: none;                     /* ❌ SUPPRIME le border blanc */
    gridline-color: #D1D9E6;           /* lignes plus douces */
    font-size: 14px;
    color: #0A1F33;
    selection-background-color: transparent;
}

/* ===== EN-TÊTES ===== */
QHeaderView::section {
    background-color: #F3F6FA;
    color: #0A1F33;
    padding: 10px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #2C5F7C;   /* ligne forte sous header */
}

/* Cache les coins moches */
QHeaderView {
    background-color: transparent;
}

/* ===== CELLULES ===== */
QTableWidget::item {
    padding: 12px;
    border-bottom: 1px solid #E3E8F0;
    border-right: 1px solid #E3E8F0;
}

/* Supprimer bordure droite dernière colonne */
QTableWidget::item:last {
    border-right: none;
}

/* ===== ZEBRA STYLE ===== */
QTableWidget::item:!selected:nth-child(even) {
    background-color: #F8FAFD;
}

/* ===== HOVER ===== */
QTableWidget::item:hover {
    background-color: #EAF2FB;
}

/* ===== SELECTION ===== */
QTableWidget::item:selected {
    background-color: #2C5F7C;
    color: white;
    border-radius: 4px;
}

/* ===== SCROLLBAR ===== */
QScrollBar:vertical {
    background: #F1F4F8;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #2C5F7C;
    border-radius: 5px;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0px;
}
</string>
