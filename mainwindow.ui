             <widget class="QPushButton" name="pushButton_5">
              <property name="geometry">
               <rect>
                <x>1070</x>
                <y>10</y>
                <width>131</width>
                <height>51</height>
               </rect>
              </property>
              <property name="font">
               <font>
                <pointsize>-1</pointsize>
                <italic>false</italic>
                <fontweight>DemiBold</fontweight>
               </font>
              </property>
              <property name="styleSheet">
               <string notr="true">QPushButton {
    background-color: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #2C5F7C,
        stop:0.5 #3A6EA5,
        stop:1 #1B3A57
    );

    color: white;
    font-size: 14px;
    font-weight: 600;

    border: none;
    border-radius: 14px;

    padding: 10px 22px;
}

/* ✨ HOVER : lumière douce */
QPushButton:hover {
    background-color: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #3A6EA5,
        stop:0.5 #4A86C5,
        stop:1 #2C5F7C
    );
}

/* 🔘 CLICK (pressed) */
QPushButton:pressed {
    background-color: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #1B3A57,
        stop:1 #2C5F7C
    );
}

/* 🚫 Désactivé */
QPushButton:disabled {
    background-color: #C8D3DF;
    color: #6E7F91;
}
</string>
