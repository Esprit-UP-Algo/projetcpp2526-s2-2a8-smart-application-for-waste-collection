         <property name="styleSheet">
          <string notr="true">/* ── FOND GÉNÉRAL DE LA SECTION ── */
QFrame#frameClassification,
QWidget#widgetClassification {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                    stop:0 #1a1a2e, stop:1 #16213e);
    border-radius: 16px;
    padding: 20px;
}

/* ── TITRE ── */
QLabel#labelTitreClassif {
    color: #blanc;
    font-size: 18px;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;;
    letter-spacing: 1px;
    padding-bottom: 10px;
}

/* ── COMBOBOX ── */
QComboBox {
    background-color: #0f3460;
    color: #ffffff;
    border: 1px solid #00cec9;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
    font-family: &quot;Segoe UI&quot;;
    min-width: 140px;
}

QComboBox:hover {
    border-color: #74b9ff;
    background-color: #1a4a7a;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #0f3460;
    color: #ffffff;
    border: 1px solid #00cec9;
    selection-background-color: #00cec9;
    selection-color: #000000;
    border-radius: 6px;
}

/* ── BOUTON CLASSIFIER ── */
QPushButton#btnClassifier {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                    stop:0 #00b894, stop:1 #00cec9);
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;;
    border: none;
    border-radius: 10px;
    padding: 10px 30px;
    letter-spacing: 1px;
}

QPushButton#btnClassifier:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                    stop:0 #00cec9, stop:1 #74b9ff);
}

QPushButton#btnClassifier:pressed {
    background-color: #009e7f;
    padding-top: 12px;
}

/* ── LABEL RÉSULTAT ── */
QLabel#labelResultatClassif {
    background-color: transparent;
    color: #dfe6e9;
    font-family: &quot;Segoe UI&quot;;
    font-size: 13px;
    border-radius: 10px;
    padding: 12px;
    min-height: 160px;
}
QGroupBox {
    border: none;
    margin-top: 10px;
    font-weight: bold;
    color: white;
}</string>
