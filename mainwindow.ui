            <property name="styleSheet">
             <string notr="true">QPushButton {
    background-color: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #1B3A2F,
        stop:0.5 #276646,
        stop:1 #1E4D36
    );
    color: white;
    font-size: 14px;
    font-weight: 700;      /* un peu plus bold pour valider */
    text-transform: uppercase;  /* donne un effet bouton d’action */
    border: none;
    border-radius: 12px;
    padding: 10px 22px;     /* garde la même taille */
    cursor: pointer;        /* main au survol */
    transition: all 0.2s ease-in-out; /* effet smooth hover */
}

/* ✨ Hover : lumière douce */
QPushButton:hover {
    background-color: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #276646,
        stop:0.5 #34885A,
        stop:1 #1B3A2F
    );
    transform: scale(1.03);  /* effet léger au survol */
}

/* 🔘 Click (pressed) */
QPushButton:pressed {
    background-color: qlineargradient(
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #1E4D36,
        stop:1 #1B3A2F
    );
    transform: scale(0.98); /* effet click */
}

/* 🚫 Désactivé */
QPushButton:disabled {
    background-color: #A3B7A1;
    color: #6E7F70;
    cursor: default;
}
</string>
