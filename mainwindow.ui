              <property name="styleSheet">
               <string notr="true">QLineEdit {
    background-color: #F9FBFD;          /* fond clair élégant */
    border: 2px solid #3A6EA5;           /* bleu marine clair */
    border-radius: 12px;
    padding: 10px 14px;
    color: #0A1F33;                      /* texte bleu marine foncé */
    font-size: 14px;
    font-weight: 500;
}

/* Quand le champ est sélectionné */
QLineEdit:focus {
    background-color: white;
    border: 2px solid #1E3A5F;           /* focus plus foncé */
}

/* Hover */
QLineEdit:hover {
    border: 2px solid #2F5D8A;
}
</string>
